generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  email String @unique
  name String
  password String
  program String
  branch String
  year Int
  avatarUrl String
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  connectionsAsRequester Connection[] @relation("ConnectionsRequester")
  connectionsAsReceiver Connection[] @relation("ConnectionsReceiver")

  reviewsGiven Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
}

model Post {
  id String @id @default(uuid())
  userId String
  type String //Learning req or Teaching offer
  subject String
  description String
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  connections Connection[]
}

model Connection {
  id String @id @default(uuid())
  requesterId String
  receiverId String
  postId String
  status String @default("pending") // pending, accepted, rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requester User @relation("ConnectionsRequester", fields: [requesterId], references: [id])
  receiver User @relation("ConnectionsReceiver", fields: [receiverId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  reviews Review[]
}

model Review {
  id String @id @default(uuid())
  connectionId String
  reviewerId String
  revieweeId String
  rating Int
  comment String
  createdAt DateTime @default(now())

  connection Connection @relation(fields: [connectionId], references: [id])
  reviewer User @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewee User @relation("ReviewsReceived", fields: [revieweeId], references: [id])
}